# EmailJS settings for the appointment form (https://dashboard.emailjs.com)
# Copy this file to .env.local for local development, and add the same three
# variables in your hosting provider's environment settings for production.
# All three are safe to expose in the browser; restrict your EmailJS account
# to your website's domain under Account > Security.

# Email Services > your Yahoo service > Service ID
VITE_EMAILJS_SERVICE_ID=

# Email Templates > your appointment template > Template ID
VITE_EMAILJS_TEMPLATE_ID=

# Account > General > Public Key
VITE_EMAILJS_PUBLIC_KEY=
